# ============================================================
# Telegram Remote Dev Agent - Cấu hình Môi trường Mẫu (.env)
# ============================================================
# Hướng dẫn: Sao chép tệp này thành '.env' và nhập các thông số của bạn.
# ⚠️ KHÔNG ĐƯỢC COMMIT TỆP '.env' LÊN GITHUB ĐỂ BẢO VỆ MÁY TÍNH CỦA BẠN.

# ------ Cấu hình Telegram Bot ------
# Token bảo mật của Bot lấy từ @BotFather (VD: 1234567890:ABCdef...)
BOT_TOKEN=your_telegram_bot_token_here

# Chat ID Telegram cá nhân của bạn để phân quyền điều khiển (lấy từ @userinfobot)
# Chỉ duy nhất ID này mới có quyền gửi lệnh và thao tác với máy tính của bạn.
ALLOWED_CHAT_ID=your_telegram_chat_id_here

# ------ Cấu hình Thư mục dự án ------
# Thư mục gốc chứa các dự án lập trình của bạn (VD: D:\Projects hoặc D:\ADMIN)
# Bot sẽ quét các thư mục con trong đường dẫn này để hiển thị trong menu /projects
PROJECT_PATH=D:\path\to\your\projects\directory

# ------ Cấu hình Trí tuệ nhân tạo (AI Agent) ------
# Lệnh gọi CLI của AI Agent đang cài đặt trên máy tính của bạn
# Hỗ trợ: gemini, claude, codex...
# (Khuyến nghị dùng gemini kèm cờ --skip-trust để chạy không tương tác)
AI_COMMAND=gemini.cmd --model gemini-2.0-flash-exp --skip-trust

# API Key cho Gemini (lấy miễn phí tại: https://aistudio.google.com/apikey)
# Key này sẽ được nạp động vào môi trường khi bot thực thi các prompt của bạn.
GEMINI_API_KEY=your_gemini_api_key_here

# ------ Tinh chỉnh Context & Bộ nhớ của AI ------
# Số lượt hội thoại trước đó (User/AI) được gửi kèm làm context cho prompt mới
# Số càng lớn thì AI càng nhớ sâu nhưng sẽ tiêu tốn nhiều token của bạn hơn.
MEMORY_CONTEXT_N=5

# Giới hạn số lượt hội thoại tối đa lưu trữ trong file history.json
MEMORY_MAX_ENTRIES=100

# Độ sâu quét cây thư mục dự án khi tạo tệp context GEMINI.md (mặc định: 2)
CONTEXT_TREE_DEPTH=2

# ------ Cấu hình mặc định cho Dự án (Fallback) ------
# Các cấu hình này sẽ tự động được sử dụng nếu dự án con không có file .env riêng.

# Lệnh build mặc định (VD: npm run build, mvn clean package, python build.py)
BUILD_COMMAND=npm run build

# Đường dẫn đến docker-compose.yml mặc định (để trống nếu không dùng Docker)
DOCKER_COMPOSE_PATH=D:\path\to\your\projects\directory\docker-compose.yml
