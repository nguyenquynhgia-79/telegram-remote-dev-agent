# ============================================================
# Telegram Remote Dev Agent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.

# ------ Telegram Bot Settings ------
# Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID (get from @userinfobot)
ALLOWED_CHAT_ID=your_chat_id_here

# ------ Project Settings ------
# Absolute path to your project directory (used by Git/Build modules)
PROJECT_PATH=D:\your\project\path

# ------ AI Command Settings ------
# The CLI command to invoke the AI agent (e.g., codex, claude, gemini)
AI_COMMAND=gemini

# ------ Build Settings ------
# The command used to build your project
# Examples: "mvn clean package", "npm run build", "python build.py"
BUILD_COMMAND=npm run build

# ------ Docker Settings ------
# Absolute path to your docker-compose.yml file (optional)
DOCKER_COMPOSE_PATH=D:\your\project\path\docker-compose.yml
